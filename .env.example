# GharSewa Environment Configuration (Example)
# Copy to .env.local for local development. Never commit real credentials or .env.local to Git.

# Runtime connection to PostgreSQL (supports PgBouncer / pooled connection)
DATABASE_URL="postgresql://user:password@localhost:5432/gharsewa?schema=public"

# Direct unpooled connection to PostgreSQL (mandatory for Prisma DDL migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/gharsewa?schema=public"

# Secret salt for rate-limit key hashing (HMAC-SHA256)
RATE_LIMIT_SALT="replace-with-a-secure-random-salt-for-rate-limiting"

# Secret pepper for auth tokens and OTP hashing (HMAC-SHA256)
AUTH_SECRET="replace-with-a-32-byte-secure-auth-secret"

# Secret token for internal cron reconciliation endpoints
CRON_SECRET="replace-with-a-secure-random-secret-for-cron-triggers"

# Authentication Providers
OTP_PROVIDER="mock" # Options: mock | twilio | msg91

# Google OAuth (Register credentials at https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback/google"

# Canonical App URL
APP_URL="http://localhost:3000"
