// GharSewa Prisma Configuration
// Master Baseline v1.4 / Phase 1.5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Foundational schema health record for Phase 1.5 verification.
model SchemaBaseline {
  id        String   @id @default(uuid()) @db.Uuid
  version   String   @default("1.5.0")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("schema_baseline")
}

// -------------------------------------------------------------
// PHASE 2: Customer Experience & Service Catalog Models
// -------------------------------------------------------------

enum PricingModel {
  FLAT
  BASE_PLUS_HOURLY
  INSPECTION_FIRST

  @@map("pricing_model")
}

model ServiceCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  slug         String    @unique @db.VarChar(100)
  description  String    @db.Text
  icon         String    @db.VarChar(50)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  services     Service[]

  @@map("service_categories")
}

model Service {
  id                      String              @id @default(uuid()) @db.Uuid
  categoryId              String              @map("category_id") @db.Uuid
  name                    String              @db.VarChar(150)
  slug                    String              @unique @db.VarChar(150)
  shortDescription        String              @map("short_description") @db.VarChar(300)
  description             String              @db.Text
  included                String[]
  excluded                String[]
  conditions              String[]
  pricingModel            PricingModel        @default(FLAT) @map("pricing_model")
  basePrice               Int                 @map("base_price") // INR
  estimatedDurationMinutes Int                @default(60) @map("estimated_duration_minutes")
  isActive                Boolean             @default(true) @map("is_active")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  category                ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceAreas            ServiceAreaService[]

  @@index([categoryId])
  @@map("services")
}

model ServiceArea {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(100)
  slug         String               @unique @db.VarChar(100)
  city         String               @default("Gangtok") @db.VarChar(100)
  pinCode      String               @map("pin_code") @db.VarChar(10)
  displayOrder Int                  @default(0) @map("display_order")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  services     ServiceAreaService[]

  @@map("service_areas")
}

model ServiceAreaService {
  serviceId     String      @map("service_id") @db.Uuid
  serviceAreaId String      @map("service_area_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")

  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([serviceId, serviceAreaId])
  @@map("service_area_services")
}

// -------------------------------------------------------------
// PHASE 3: Authentication & Customer Identity Models
// -------------------------------------------------------------

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN

  @@map("user_role")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  phone         String?   @unique @db.VarChar(15)
  phoneVerified Boolean   @default(false) @map("phone_verified")
  email         String?   @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  fullName      String?   @map("full_name") @db.VarChar(150)
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customerProfile CustomerProfile?
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  auditLogs       AuditLog[]

  @@map("users")
}

model CustomerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  preferredLanguage String   @default("en") @map("preferred_language") @db.VarChar(10)
  defaultAddressId  String?  @map("default_address_id") @db.Uuid
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50) // e.g. "google"
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  email          String?  @db.VarChar(255)
  name           String?  @db.VarChar(150)
  avatarUrl      String?  @map("avatar_url") @db.Text
  linkedAt       DateTime @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
  idleExpiresAt       DateTime  @map("idle_expires_at") @db.Timestamptz
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz
  lastAuthenticatedAt DateTime  @default(now()) @map("last_authenticated_at") @db.Timestamptz
  rotatedAt           DateTime? @map("rotated_at") @db.Timestamptz
  replacedByHash      String?   @map("replaced_by_hash") @db.VarChar(64)
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  userAgent           String?   @map("user_agent") @db.Text
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tokenHash, idleExpiresAt, absoluteExpiresAt])
  @@index([userId])
  @@map("sessions")
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneHash   String    @map("phone_hash") @db.VarChar(64)
  otpHash     String    @map("otp_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([phoneHash, createdAt])
  @@index([phoneHash, expiresAt])
  @@map("otp_challenges")
}

model RateLimitEvent {
  id          String   @id @default(uuid()) @db.Uuid
  keyHash     String   @map("key_hash") @db.VarChar(64)
  windowStart DateTime @map("window_start") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([keyHash, createdAt])
  @@map("rate_limit_events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
